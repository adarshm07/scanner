# --- LLM providers (used only for triage + executive summary) ---
# Default posture: Claude disabled, Gemini enabled. The frontend lets the user
# pick among providers that are enabled AND have a key present.

# Gemini (enabled by default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true

# Claude (disabled by default)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ENABLED=false

# OpenAI-compatible gateway (disabled by default). Put the real key in .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=global-openai-chat-models/gpt-4-1-nano
OPENAI_ENABLED=false

# With no usable provider the pipeline runs in deterministic-only mode
# (triage degrades to a pass-through verdict; summary generated in code).

# Server port
PORT=4000

# Comma-separated browser origins allowed to read API responses.
# Requests without an Origin header are allowed (for CLI and server-side clients).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scan endpoints are limited to 10 requests per IP every 15 minutes.
# Behind a proxy/load balancer, set the number of proxy hops (usually 1) so each
# client gets its own bucket. Leave empty when the server is reached directly.
TRUST_PROXY=

# Repo scans only clone https URLs on these hosts.
REPO_HOST_ALLOWLIST=github.com,gitlab.com,bitbucket.org

# Domain and repo targets resolving to private, loopback or link-local addresses
# are refused. Set true only for local fixture testing; never on a public host.
ALLOW_PRIVATE_TARGETS=false

# In-memory report retention.
REPORT_TTL_MS=86400000
REPORT_MAX=500

# Semgrep rules: registry name or a local rules file (for air-gapped runners).
# Defaults to p/security-audit, downloaded from semgrep.dev at scan time.
SEMGREP_CONFIG=

# Severity floor: findings at/below this are dropped when confidence is also low.
# One of: critical | high | medium | low
SEVERITY_FLOOR=low
