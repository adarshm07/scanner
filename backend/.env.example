# --- LLM providers (used only for triage + executive summary) ---
# Default posture: Claude disabled, Gemini enabled. The frontend lets the user
# pick among providers that are enabled AND have a key present.

# Gemini (enabled by default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true

# Claude (disabled by default)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_ENABLED=false

# With no usable provider the pipeline runs in deterministic-only mode
# (triage degrades to a pass-through verdict; summary generated in code).

# Server port
PORT=4000

# Comma-separated browser origins allowed to read API responses.
# Requests without an Origin header are allowed (for CLI and server-side clients).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scan endpoints are limited to 10 requests per IP every 15 minutes.

# Severity floor: findings at/below this are dropped when confidence is also low.
# One of: critical | high | medium | low
SEVERITY_FLOOR=low
