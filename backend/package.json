{
  "name": "scanner-x-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "AI-assisted security review orchestrator backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "node dist/cli.js",
    "serve:exposed-fixture": "node fixtures/serve-exposed-files.js",
    "serve:csp-fixtures": "node fixtures/serve-csp-fixtures.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "openai": "^7.34.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  },
  "bin": {
    "scanner-x": "dist/cli.js"
  }
}
