{
  "name": "scanner-x-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "AI-assisted security review orchestrator backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve:exposed-fixture": "node fixtures/serve-exposed-files.js",
    "serve:csp-fixtures": "node fixtures/serve-csp-fixtures.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
